# ==================== BANCO DE DADOS ====================
# URL de conexao com o PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_BANCO
DATABASE_URL="postgresql://clinica:clinica123@localhost:5432/clinica_pwa"

# ==================== AUTENTICACAO ====================
# Chave secreta para o Auth.js (NextAuth)
# IMPORTANTE: Gere uma chave forte para producao
# Use: openssl rand -base64 32
NEXTAUTH_SECRET="sua-chave-secreta-aqui-mude-para-producao"

# URL base da aplicacao
NEXTAUTH_URL="http://localhost:3000"

# ==================== GOOGLE OAuth (Opcional) ====================
# Credenciais do Google Cloud Console
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ==================== PAGAMENTO ====================
# Mercado Pago ou Asaas
# MERCADO_PAGO_ACCESS_TOKEN=""
# ASAAS_API_KEY=""

# ==================== EMAIL (Opcional) ====================
# Servico de email transacional (Resend, SendGrid, etc.)
# RESEND_API_KEY=""

# ==================== WHATSAPP (Opcional) ====================
# WhatsApp Cloud API
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""

# ==================== PRODUCAO ====================
# Em producao, defina NODE_ENV=production
# NODE_ENV="production"
