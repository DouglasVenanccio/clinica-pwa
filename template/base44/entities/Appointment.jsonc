{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "professional_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "duration_min": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "default": "pending"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "pix",
        "credit",
        "debit"
      ],
      "default": "pix"
    },
    "total_price": {
      "type": "number"
    }
  },
  "required": [
    "client_name",
    "service_name",
    "date",
    "time"
  ]
}