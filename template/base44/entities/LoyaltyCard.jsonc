{
  "name": "LoyaltyCard",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "points": {
      "type": "number",
      "default": 0
    },
    "visits": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    },
    "tier": {
      "type": "string",
      "enum": [
        "bronze",
        "prata",
        "ouro",
        "diamante"
      ],
      "default": "bronze"
    }
  },
  "required": [
    "client_email"
  ]
}